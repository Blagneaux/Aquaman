\@writefile{toc}{\contentsline {subsection}{\numberline {(a)}Classifier performance on simulated pressure segments}{7}{subsection.3.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {(b)}Consistency of measured pressure signals with the models}{7}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Classification of measured pressure segments with 95\% of simulated variance retained. Panels show the Raw, Size-constrained, X-deformation and Full variants. Blue, orange and grey curves represent fish-like, cylinder-like and undetermined fractions, respectively. Lines connect the evaluated confidence thresholds and markers show individual threshold values. In the X-deformation panel, crosses and coloured labels identify the final values at a 0.99 threshold: 30.3\% fish-like (132/436) and 4.4\% cylinder-like (19/436).}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:result95SVD}{{4}{8}{Classification of measured pressure segments with 95\% of simulated variance retained. Panels show the Raw, Size-constrained, X-deformation and Full variants. Blue, orange and grey curves represent fish-like, cylinder-like and undetermined fractions, respectively. Lines connect the evaluated confidence thresholds and markers show individual threshold values. In the X-deformation panel, crosses and coloured labels identify the final values at a 0.99 threshold: 30.3\% fish-like (132/436) and 4.4\% cylinder-like (19/436)}{figure.4}{}}
\newlabel{fig:result95SVD@cref}{{[figure][4][]4}{[1][7][]8}}
\@writefile{toc}{\contentsline {subsection}{\numberline {(c)}Fish-associated vortices were smaller, straighter and more numerous}{8}{subsection.3.3}\protected@file@percent }
\abx@aux@cite{0}{colvert2018}
