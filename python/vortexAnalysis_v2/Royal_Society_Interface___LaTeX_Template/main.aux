\abx@aux@cite{0}{lundberg2017}
\abx@aux@segm{0}{0}{lundberg2017}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Schematic representation of the methodology. (1) Simulation stage: fish-shaped digital twin and cylinder surrogates are generated under different model variants (raw, size-constrained, x-deformation and full). Pressure signals are extracted from vortex tracking and assembled into a data matrix. (2) Dimensionality reduction and classification training: SVD is applied to construct a reduced basis capturing most of the dataset variance. Pressure signals are projected onto this basis to form feature vectors, which train a linear classifier to distinguish fish-like and cylinder-like simulations and define a learned similarity metric. (3) Inference: experimental pressure signals are projected onto the same feature space and evaluated with this metric.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:classifier}{{2}{5}{Schematic representation of the methodology. (1) Simulation stage: fish-shaped digital twin and cylinder surrogates are generated under different model variants (raw, size-constrained, x-deformation and full). Pressure signals are extracted from vortex tracking and assembled into a data matrix. (2) Dimensionality reduction and classification training: SVD is applied to construct a reduced basis capturing most of the dataset variance. Pressure signals are projected onto this basis to form feature vectors, which train a linear classifier to distinguish fish-like and cylinder-like simulations and define a learned similarity metric. (3) Inference: experimental pressure signals are projected onto the same feature space and evaluated with this metric}{figure.2}{}}
\newlabel{fig:classifier@cref}{{[figure][2][]2}{[1][4][]5}}
\@writefile{toc}{\contentsline {subsection}{\numberline {(f)}Interpreting vortex features}{5}{subsection.2.6}\protected@file@percent }
