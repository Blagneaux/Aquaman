\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces SHAP summary plot for the second-stage vortex-feature classifier. Negative SHAP values contribute to fish-like classification and positive values to cylinder-like classification. Point colour represents the normalised feature value, from low (blue) to high (red). The most informative descriptors concerned displacement, distance from the body, tank-axis $x$ position, travelled path and duration.}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:shap}{{4}{8}{SHAP summary plot for the second-stage vortex-feature classifier. Negative SHAP values contribute to fish-like classification and positive values to cylinder-like classification. Point colour represents the normalised feature value, from low (blue) to high (red). The most informative descriptors concerned displacement, distance from the body, tank-axis $x$ position, travelled path and duration}{figure.4}{}}
\newlabel{fig:shap@cref}{{[figure][4][]4}{[1][7][]8}}
