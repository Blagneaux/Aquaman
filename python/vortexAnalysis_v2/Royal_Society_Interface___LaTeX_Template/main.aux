\abx@aux@cite{0}{lakkam2019}
\abx@aux@segm{0}{0}{lakkam2019}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Paired source-video differences for pressure-conditioned vortex descriptors. Each point is the cylinder-associated source-video mean minus the fish-associated source-video mean for one of the ten videos represented in both groups. Positive values indicate larger cylinder-associated summaries and negative values indicate larger fish-associated summaries, and the dotted line marks zero difference. Because the descriptors carry different units, each difference is divided by the standard deviation of that descriptor's own ten differences so that every row shares the horizontal axis. The displacement of a row from zero therefore expresses a standardised effect size rather than a physical magnitude. Mean differences and 95\% $t$-based confidence intervals in the original units of each descriptor are annotated on the right. Diamonds mark the mean and horizontal bars the confidence interval. Orange denotes descriptors whose cylinder-associated summary was larger and blue those whose fish-associated summary was larger. Rows whose interval contains zero are drawn muted. Rows are ordered by standardised difference, from the strongest cylinder-associated contrast at the top to the strongest fish-associated contrast at the bottom. Vortices per segment, total vortex-frame occupancy and mean and maximum simultaneous vortices are segment-level descriptors, and the remaining seventeen are track-level. The intervals are not adjusted for the number of descriptors examined.}}{9}{figure.5}\protected@file@percent }
\newlabel{fig:vortex_distributions}{{5}{9}{Paired source-video differences for pressure-conditioned vortex descriptors. Each point is the cylinder-associated source-video mean minus the fish-associated source-video mean for one of the ten videos represented in both groups. Positive values indicate larger cylinder-associated summaries and negative values indicate larger fish-associated summaries, and the dotted line marks zero difference. Because the descriptors carry different units, each difference is divided by the standard deviation of that descriptor's own ten differences so that every row shares the horizontal axis. The displacement of a row from zero therefore expresses a standardised effect size rather than a physical magnitude. Mean differences and 95\% $t$-based confidence intervals in the original units of each descriptor are annotated on the right. Diamonds mark the mean and horizontal bars the confidence interval. Orange denotes descriptors whose cylinder-associated summary was larger and blue those whose fish-associated summary was larger. Rows whose interval contains zero are drawn muted. Rows are ordered by standardised difference, from the strongest cylinder-associated contrast at the top to the strongest fish-associated contrast at the bottom. Vortices per segment, total vortex-frame occupancy and mean and maximum simultaneous vortices are segment-level descriptors, and the remaining seventeen are track-level. The intervals are not adjusted for the number of descriptors examined}{figure.5}{}}
\newlabel{fig:vortex_distributions@cref}{{[figure][5][]5}{[1][8][]9}}
