\abx@aux@cite{0}{wilson1927}
\abx@aux@segm{0}{0}{wilson1927}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Classification of measured pressure segments with 95\% of simulated variance retained. Panels show the raw, size-constrained, x-deformation and full variants. Blue, orange and grey curves represent fish-like, cylinder-like and undetermined fractions, respectively. Dashed lines connect the evaluated confidence thresholds and markers show individual threshold values. In the x-deformation panel, crosses and coloured labels identify the final values at a 0.99 threshold: 30.3\% fish-like (132/436) and 4.4\% cylinder-like (19/436).}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:result95SVD}{{4}{7}{Classification of measured pressure segments with 95\% of simulated variance retained. Panels show the raw, size-constrained, x-deformation and full variants. Blue, orange and grey curves represent fish-like, cylinder-like and undetermined fractions, respectively. Dashed lines connect the evaluated confidence thresholds and markers show individual threshold values. In the x-deformation panel, crosses and coloured labels identify the final values at a 0.99 threshold: 30.3\% fish-like (132/436) and 4.4\% cylinder-like (19/436)}{figure.4}{}}
\newlabel{fig:result95SVD@cref}{{[figure][4][]4}{[1][7][]7}}
