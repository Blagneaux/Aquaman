\@writefile{toc}{\contentsline {subsection}{\numberline {(b)}Using sparse pressure measurements to evaluate wake realism}{3}{subsection.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Schematic representation of the methodology. (1) Simulation stage: fish-shaped digital twin and cylinder surrogates are generated under different model variants (raw, size-constrained, x-deformation and full). Pressure signals are extracted from vortex tracking and assembled into a data matrix. (2) Dimensionality reduction and classification training: SVD is applied to construct a reduced basis capturing most of the dataset variance. Pressure signals are projected onto this basis to form feature vectors, used to train a linear classifier into distinguishing fish-like and cylinder-like simulations, hence defining a learned similarity metric. (3) Inference: experimental pressure signals are projected onto the same feature space and evaluated with this metric.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:classifier}{{2}{4}{Schematic representation of the methodology. (1) Simulation stage: fish-shaped digital twin and cylinder surrogates are generated under different model variants (raw, size-constrained, x-deformation and full). Pressure signals are extracted from vortex tracking and assembled into a data matrix. (2) Dimensionality reduction and classification training: SVD is applied to construct a reduced basis capturing most of the dataset variance. Pressure signals are projected onto this basis to form feature vectors, used to train a linear classifier into distinguishing fish-like and cylinder-like simulations, hence defining a learned similarity metric. (3) Inference: experimental pressure signals are projected onto the same feature space and evaluated with this metric}{figure.2}{}}
\newlabel{fig:classifier@cref}{{[figure][2][]2}{[1][3][]4}}
\@writefile{toc}{\contentsline {subsection}{\numberline {(c)}Interpreting which vortex features carry fish-specific information}{4}{subsection.2.3}\protected@file@percent }
