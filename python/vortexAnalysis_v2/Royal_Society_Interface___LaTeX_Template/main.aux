\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces SHAP summary plot for the second stage vortex-feature classifier. The most informative descriptors were related to vortex displacement, distance from the body, streamwise position, travelled path and duration, hinting that fish-specific information was expressed primarily through spatial organisation and persistence of vortical structures.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:shap}{{4}{7}{SHAP summary plot for the second stage vortex-feature classifier. The most informative descriptors were related to vortex displacement, distance from the body, streamwise position, travelled path and duration, hinting that fish-specific information was expressed primarily through spatial organisation and persistence of vortical structures}{figure.4}{}}
\newlabel{fig:shap@cref}{{[figure][4][]4}{[1][6][]7}}
