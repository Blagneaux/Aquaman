\@writefile{toc}{\contentsline {subsection}{\numberline {(e)}Comparative pressure-signal classification}{5}{subsection.2.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {(f)}Distributional comparison of pressure-conditioned vortices}{5}{subsection.2.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Schematic representation of the methodology. (1) Simulation stage: fish-shaped digital twin and cylinder surrogates are generated under different model variants (Raw, Size-constrained, X-deformation and Full). Pressure signals are extracted from vortex tracking and assembled into a data matrix. (2) Dimensionality reduction and classification training: SVD is applied to construct a reduced basis capturing most of the dataset variance. Pressure signals are projected onto this basis to form feature vectors, which train a linear classifier to distinguish fish-like and cylinder-like simulations and define a learned similarity metric. (3) Inference: experimental pressure signals are projected onto the same feature space and evaluated with this metric.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:classifier}{{3}{6}{Schematic representation of the methodology. (1) Simulation stage: fish-shaped digital twin and cylinder surrogates are generated under different model variants (Raw, Size-constrained, X-deformation and Full). Pressure signals are extracted from vortex tracking and assembled into a data matrix. (2) Dimensionality reduction and classification training: SVD is applied to construct a reduced basis capturing most of the dataset variance. Pressure signals are projected onto this basis to form feature vectors, which train a linear classifier to distinguish fish-like and cylinder-like simulations and define a learned similarity metric. (3) Inference: experimental pressure signals are projected onto the same feature space and evaluated with this metric}{figure.3}{}}
\newlabel{fig:classifier@cref}{{[figure][3][]3}{[1][5][]6}}
