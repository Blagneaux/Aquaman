\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Effect of the minimum vortex-to-body distance on measured pressure classification for the x-deformation model at 0.99 confidence. The x-axis gives the exclusion threshold in 1 mm simulation-grid cells. Blue, grey and orange represent fish-like, undetermined and cylinder-like fractions, respectively. Increasing exclusion of near-body vortices increased the fish-like fraction.}}{10}{figure.6}\protected@file@percent }
\newlabel{fig:distance_filter}{{6}{10}{Effect of the minimum vortex-to-body distance on measured pressure classification for the x-deformation model at 0.99 confidence. The x-axis gives the exclusion threshold in 1 mm simulation-grid cells. Blue, grey and orange represent fish-like, undetermined and cylinder-like fractions, respectively. Increasing exclusion of near-body vortices increased the fish-like fraction}{figure.6}{}}
\newlabel{fig:distance_filter@cref}{{[figure][6][]6}{[1][8][]10}}
