\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Classification of measured pressure segments with 95\% of simulated variance retained. Panels show the raw, size-constrained, x-deformation and full variants. Blue, orange and grey curves represent fish-like, cylinder-like and undetermined fractions, respectively. Dashed lines connect the evaluated confidence thresholds and markers show individual threshold values. In the x-deformation panel, crosses and coloured labels identify the final values at a 0.99 threshold: 30.3\% fish-like (132/436) and 4.4\% cylinder-like (19/436).}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:result95SVD}{{3}{7}{Classification of measured pressure segments with 95\% of simulated variance retained. Panels show the raw, size-constrained, x-deformation and full variants. Blue, orange and grey curves represent fish-like, cylinder-like and undetermined fractions, respectively. Dashed lines connect the evaluated confidence thresholds and markers show individual threshold values. In the x-deformation panel, crosses and coloured labels identify the final values at a 0.99 threshold: 30.3\% fish-like (132/436) and 4.4\% cylinder-like (19/436)}{figure.3}{}}
\newlabel{fig:result95SVD@cref}{{[figure][3][]3}{[1][6][]7}}
